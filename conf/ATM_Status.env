SERVER=ffin-eKassa3.kassanova.lcl
PORT=1433
DATABASE=ekassir
USER=sqlexporter
PASSWORD=123sqlexporter!!!

SQL_QUERY="SELECT 
    pointID, lockState, atmName, city
FROM mon_pointLockState
JOIN atm_info ON mon_pointLockState.pointID = atm_info.id
WHERE lockState IN (1, 4)
ORDER BY city, lockState"

PROM_METRIC_NAME=atm_lock_state
METRIC_VALUE_COLUMN=lockState
QUERY_INTERVAL=30s

# 🛠 Настройки пула коннектов для этого SQL
MAX_OPEN_CONNS=3
MAX_IDLE_CONNS=1
CONN_MAX_LIFETIME=5m